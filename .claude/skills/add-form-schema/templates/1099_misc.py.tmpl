# Paste this constant into
# `src/bedrock_strands_agent/extraction/schemas/examples.py`,
# above the `register_schema(IRS_W9)` line, then add
# `register_schema(IRS_1099_MISC)` to the bottom of the file.

IRS_1099_MISC = FormSchema(
    name="irs_1099_misc",
    version="1.0.0",
    description=(
        "IRS Form 1099-MISC: Miscellaneous Income (US). Reports payments "
        "of rents, royalties, prizes, and other miscellaneous income paid "
        "to non-employees during the tax year."
    ),
    fields=(
        FieldDefinition(
            name="tax_year",
            description="Tax year the form covers, four-digit integer (e.g. 2025).",
            type=FieldType.INTEGER,
            required=True,
            pattern=r"^\d{4}$",
        ),
        FieldDefinition(
            name="payer_name",
            description="Legal name of the payer (issuer of the 1099-MISC).",
            type=FieldType.STRING,
            required=True,
        ),
        FieldDefinition(
            name="payer_tin",
            description="Payer Federal EIN, formatted 99-9999999.",
            type=FieldType.EIN,
            required=True,
            pattern=r"^\d{2}-\d{7}$",
        ),
        FieldDefinition(
            name="recipient_name",
            description="Legal name of the recipient (payee).",
            type=FieldType.STRING,
            required=True,
        ),
        FieldDefinition(
            name="recipient_tin",
            description="Recipient SSN (999-99-9999) or EIN (99-9999999).",
            type=FieldType.STRING,
            required=True,
            pattern=r"^(\d{3}-\d{2}-\d{4}|\d{2}-\d{7})$",
        ),
        FieldDefinition(
            name="rents",
            description="Box 1: Rents paid during the year, decimal currency.",
            type=FieldType.CURRENCY,
        ),
        FieldDefinition(
            name="royalties",
            description="Box 2: Royalties paid during the year, decimal currency.",
            type=FieldType.CURRENCY,
        ),
        FieldDefinition(
            name="other_income",
            description="Box 3: Other income, decimal currency.",
            type=FieldType.CURRENCY,
        ),
        FieldDefinition(
            name="federal_income_tax_withheld",
            description="Box 4: Federal income tax withheld, decimal currency.",
            type=FieldType.CURRENCY,
        ),
    ),
)
