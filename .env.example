# Service identity ----------------------------------------------------------
SERVICE_NAME=bedrock-strands-agent
SERVICE_ENV=local                # local | dev | staging | prod

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text

# HTTP ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# AWS / Bedrock -------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0
BEDROCK_TOP_P=0.9

# OpenTelemetry -------------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=               # falls back to SERVICE_NAME if empty
STRANDS_OTEL_ENABLE_CONSOLE_EXPORT=false

# Model Context Protocol ---------------------------------------------------
# Comma-separated list of server names from mcp.config.json to start.
MCP_ENABLED_SERVERS=
MCP_CONFIG_PATH=mcp.config.json

# Auth ---------------------------------------------------------------------
# Mode controls which credential AuthMiddleware checks.
#   none   — no auth (legacy / behind-mesh).
#   apikey — X-API-Key against API_KEYS allowlist.
#   jwt    — Authorization: Bearer ... validated against Cognito JWKS.
#   both   — accept either.
# When RUNTIME_MODE=agentcore (Phase B), AgentCore Runtime's custom_jwt_authorizer
# validates JWTs first; this layer should be set to apikey for defense-in-depth.
AUTH_MODE=none
API_KEYS=                          # CSV of valid keys, e.g. dev-key,ci-key
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=                      # Cognito: https://cognito-idp.<region>.amazonaws.com/<pool>/.well-known/jwks.json
AUTH_EXCLUDED_PATHS=/health,/metrics,/docs,/openapi.json,/redoc

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
