# Service identity ----------------------------------------------------------
SERVICE_NAME=bedrock-strands-agent
SERVICE_ENV=local                # local | dev | staging | prod

# Logging -------------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text

# HTTP ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# AWS / Bedrock -------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20250514-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0
BEDROCK_TOP_P=0.9

# OpenTelemetry -------------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=               # falls back to SERVICE_NAME if empty
STRANDS_OTEL_ENABLE_CONSOLE_EXPORT=false

# Model Context Protocol ---------------------------------------------------
# Comma-separated list of server names from mcp.config.json to start.
MCP_ENABLED_SERVERS=
MCP_CONFIG_PATH=mcp.config.json
